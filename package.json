{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "description": "Strength-training log. Repository name only — product name is gated by BRAND-01 (see docs/DECISIONS.md).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:test": "supabase test db",
    "scan:secrets": "gitleaks detect --no-banner --redact   # runs in CI; local needs gitleaks installed",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:catalog": "tsx scripts/catalog/8-validate.ts   # joins verify at M0.10 (SPIKE-06)"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
