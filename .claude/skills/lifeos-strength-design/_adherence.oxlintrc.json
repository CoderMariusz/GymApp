      {
        "selector": "JSXOpeningElement[name.name='VolumeBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|height|labels|highlightLast|key|ref|className|style|children)$/]",
        "message": "<VolumeBars> doesn't accept that prop. Declared props: data, height, labels, highlightLast."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|key|ref|className|style|children)$/]",
        "message": "<WeekDots> doesn't accept that prop. Declared props: days."
      }
