# ============================================================================
# Environment template — copy to .env.local and fill in.
# NEVER commit .env.local.
# ============================================================================
#
# ARCHITECTURE.md §2.1: the client is untrusted. Only keys that are safe in a
# browser bundle may carry the NEXT_PUBLIC_ prefix.
#
# The service_role key MUST NOT appear here, in the app, or in any client
# bundle. It exists only as a Supabase Edge Function secret. A production
# bundle scan (§19.1) fails the build if a provider key is found.
# ============================================================================

# Supabase — new project (ADR-15). Both values below are browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Build metadata — CORE-10 release traceability (About screen shows these).
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_CATALOG_VERSION=

# Error telemetry. Redaction allowlist is mandatory — ARCHITECTURE.md §14.1.
NEXT_PUBLIC_SENTRY_DSN=
